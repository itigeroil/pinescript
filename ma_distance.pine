//@version=5
indicator("Price vs MA Distance", overlay=false, shorttitle="MA Distance", precision=2)

// ============ 输入参数 ============
ma20_len  = input.int(20,  title="MA 20 周期",  minval=1)
ma50_len  = input.int(50,  title="MA 50 周期",  minval=1)
ma100_len = input.int(100, title="MA 100 周期", minval=1)
ma200_len = input.int(200, title="MA 200 周期", minval=1)

ma_type   = input.string("SMA", title="均线类型", options=["SMA", "EMA", "WMA", "HMA"])
price_src = input(close, title="价格源")

// ============ 计算均线 ============
f_ma(src, len, type) =>
    type == "SMA" ? ta.sma(src, len) :
     type == "EMA" ? ta.ema(src, len) :
     type == "WMA" ? ta.wma(src, len) :
     type == "HMA" ? ta.hma(src, len) : na

ma20  = f_ma(price_src, ma20_len,  ma_type)
ma50  = f_ma(price_src, ma50_len,  ma_type)
ma100 = f_ma(price_src, ma100_len, ma_type)
ma200 = f_ma(price_src, ma200_len, ma_type)

// ============ 距离计算 ============
// 绝对距离（价格 - 均线）
dist20_abs  = close - ma20
dist50_abs  = close - ma50
dist100_abs = close - ma100
dist200_abs = close - ma200

// 相对距离（百分比）
dist20_pct  = (close - ma20)  / ma20  * 100
dist50_pct  = (close - ma50)  / ma50  * 100
dist100_pct = (close - ma100) / ma100 * 100
dist200_pct = (close - ma200) / ma200 * 100

// ============ 显示模式切换 ============
show_pct = input.bool(true, title="以百分比显示 (否则为绝对价差)")

v20  = show_pct ? dist20_pct  : dist20_abs
v50  = show_pct ? dist50_pct  : dist50_abs
v100 = show_pct ? dist100_pct : dist100_abs
v200 = show_pct ? dist200_pct : dist200_abs

unit = show_pct ? "%" : ""

// ============ 绘图 ============
hline(0, "零线", color=color.gray, linestyle=hline.style_dashed)

plot(v20,  title="距 MA20",  color=color.new(color.blue, 0),   linewidth=2)
plot(v50,  title="距 MA50",  color=color.new(color.orange, 0), linewidth=2)
plot(v100, title="距 MA100", color=color.new(color.purple, 0), linewidth=2)
plot(v200, title="距 MA200", color=color.new(color.red, 0),    linewidth=2)

// ============ 数据标签 / 表格 ============
var table info_t = table.new(position.top_right, 3, 6, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

table.cell(info_t, 0, 0, "均线",    text_color=color.white, bg_color=color.gray)
table.cell(info_t, 1, 0, "均线值",  text_color=color.white, bg_color=color.gray)
table.cell(info_t, 2, 0, "距离" + unit, text_color=color.white, bg_color=color.gray)

table.cell(info_t, 0, 1, "MA20",  text_color=color.blue)
table.cell(info_t, 1, 1, str.tostring(ma20,  "#.####"), text_color=color.blue)
table.cell(info_t, 2, 1, str.tostring(v20,  "#.##") + unit, text_color = v20  >= 0 ? color.green : color.red)

table.cell(info_t, 0, 2, "MA50",  text_color=color.orange)
table.cell(info_t, 1, 2, str.tostring(ma50,  "#.####"), text_color=color.orange)
table.cell(info_t, 2, 2, str.tostring(v50,  "#.##") + unit, text_color = v50  >= 0 ? color.green : color.red)

table.cell(info_t, 0, 3, "MA100", text_color=color.purple)
table.cell(info_t, 1, 3, str.tostring(ma100, "#.####"), text_color=color.purple)
table.cell(info_t, 2, 3, str.tostring(v100, "#.##") + unit, text_color = v100 >= 0 ? color.green : color.red)

table.cell(info_t, 0, 4, "MA200", text_color=color.red)
table.cell(info_t, 1, 4, str.tostring(ma200, "#.####"), text_color=color.red)
table.cell(info_t, 2, 4, str.tostring(v200, "#.##") + unit, text_color = v200 >= 0 ? color.green : color.red)

table.cell(info_t, 0, 5, "现价", text_color=color.white, bg_color=color.gray)
table.cell(info_t, 1, 5, str.tostring(close, "#.####"), text_color=color.white, bg_color=color.gray)
table.cell(info_t, 2, 5, "", text_color=color.white, bg_color=color.gray)

// ============ 在主图上叠加绘制均线（可选） ============
plot_on_main = input.bool(true, title="在主图显示均线")

plot(plot_on_main ? ma20  : na, title="MA20",  color=color.blue,   linewidth=2)
plot(plot_on_main ? ma50  : na, title="MA50",  color=color.orange, linewidth=2)
plot(plot_on_main ? ma100 : na, title="MA100", color=color.purple, linewidth=2)
plot(plot_on_main ? ma200 : na, title="MA200", color=color.red,    linewidth=2)
