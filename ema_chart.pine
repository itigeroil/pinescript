//@version=5
indicator("EMA均线图 20/50/100/200", overlay=true, shorttitle="EMA_Chart")

// 参数设置
ema20_len = input.int(20, title="EMA 20 周期", minval=1)
ema50_len = input.int(50, title="EMA 50 周期", minval=1)
ema100_len = input.int(100, title="EMA 100 周期", minval=1)
ema200_len = input.int(200, title="EMA 200 周期", minval=1)

// 计算EMA均线
ema20 = ta.ema(close, ema20_len)
ema50 = ta.ema(close, ema50_len)
ema100 = ta.ema(close, ema100_len)
ema200 = ta.ema(close, ema200_len)

// 绘制均线
plot(ema20, color=color.blue, title="EMA20", linewidth=2)
plot(ema50, color=color.orange, title="EMA50", linewidth=2)
plot(ema100, color=color.purple, title="EMA100", linewidth=2)
plot(ema200, color=color.red, title="EMA200", linewidth=2)

// 填充均线之间的区域（可选）
fill(plot(ema20, color=color.blue), plot(ema50, color=color.orange), color=color.new(color.blue, 90))
fill(plot(ema50, color=color.orange), plot(ema100, color=color.purple), color=color.new(color.orange, 90))
fill(plot(ema100, color=color.purple), plot(ema200, color=color.red), color=color.new(color.purple, 90))