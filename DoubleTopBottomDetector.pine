//@version=5
indicator("Double Top/Bottom Detector", overlay=true, shorttitle="DTB", precision=2)

length = input.int(20, title="Swing Length")
threshold = input.float(0.02, title="Price Threshold (%)", step=0.01) / 100
showDoubleTop = input.bool(true, title="Show Double Top")
showDoubleBottom = input.bool(true, title="Show Double Bottom")

highs = ta.highest(high, length)
lows = ta.lowest(low, length)

isDoubleTop = false
isDoubleBottom = false
topPrice = 0.0
bottomPrice = 0.0
topBarIndex = 0
bottomBarIndex = 0

pivotHigh1 = ta.pivothigh(length, length)
pivotHigh2 = ta.pivothigh(length, length)

pivotLow1 = ta.pivotlow(length, length)
pivotLow2 = ta.pivotlow(length, length)

var float[] topPivots = array.new_float()
var int[] topPivotBars = array.new_int()
var float[] bottomPivots = array.new_float()
var int[] bottomPivotBars = array.new_int()

if not na(pivotHigh1)
    array.push(topPivots, pivotHigh1)
    array.push(topPivotBars, bar_index)
    if array.size(topPivots) >= 2
        recentTop = array.get(topPivots, array.size(topPivots) - 1)
        prevTop = array.get(topPivots, array.size(topPivots) - 2)
        priceDiff = math.abs(recentTop - prevTop) / prevTop
        if priceDiff <= threshold
            recentBar = array.get(topPivotBars, array.size(topPivotBars) - 1)
            prevBar = array.get(topPivotBars, array.size(topPivotBars) - 2)
            if recentBar - prevBar > length
                isDoubleTop := true
                topPrice := (recentTop + prevTop) / 2
                topBarIndex := prevBar
                array.pop(topPivots)
                array.pop(topPivotBars)
                array.pop(topPivots)
                array.pop(topPivotBars)

if not na(pivotLow1)
    array.push(bottomPivots, pivotLow1)
    array.push(bottomPivotBars, bar_index)
    if array.size(bottomPivots) >= 2
        recentBottom = array.get(bottomPivots, array.size(bottomPivots) - 1)
        prevBottom = array.get(bottomPivots, array.size(bottomPivots) - 2)
        priceDiff = math.abs(recentBottom - prevBottom) / prevBottom
        if priceDiff <= threshold
            recentBar = array.get(bottomPivotBars, array.size(bottomPivotBars) - 1)
            prevBar = array.get(bottomPivotBars, array.size(bottomPivotBars) - 2)
            if recentBar - prevBar > length
                isDoubleBottom := true
                bottomPrice := (recentBottom + prevBottom) / 2
                bottomBarIndex := prevBar
                array.pop(bottomPivots)
                array.pop(bottomPivotBars)
                array.pop(bottomPivots)
                array.pop(bottomPivotBars)

if showDoubleTop and isDoubleTop
    label.new(bar_index, topPrice, "Double Top", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
    line.new(topBarIndex, topPrice, bar_index, topPrice, color=color.red, style=line.style_dashed)

if showDoubleBottom and isDoubleBottom
    label.new(bar_index, bottomPrice, "Double Bottom", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)
    line.new(bottomBarIndex, bottomPrice, bar_index, bottomPrice, color=color.green, style=line.style_dashed)

plotshape(showDoubleTop and isDoubleTop, title="Double Top Signal", location=location.belowbar, color=color.red, style=shape.triangleup, size=size.small)
plotshape(showDoubleBottom and isDoubleBottom, title="Double Bottom Signal", location=location.abovebar, color=color.green, style=shape.triangledown, size=size.small)