//@version=5
indicator("多时间框架EMA", overlay=true, shorttitle="MTF EMA")

// 参数设置
maPeriod = input.int(20, "EMA周期", minval=1)
sourcePrice = input(close, "计算源")
showLastBars = input.int(5, "显示最近N根K线标记", minval=1, maxval=100)

// 目标时间框架设置
targetTF = input.string("5", "目标时间周期", options=["1", "3", "5", "10", "15", "30", "45", "60", "120", "240", "D", "W"])
tfSuffix = input.string("分钟", "时间周期后缀", tooltip="显示在标签上的后缀")

// 获取目标时间框架的EMA数据
targetEma = request.security(syminfo.tickerid, targetTF, ta.ema(sourcePrice, maPeriod))

// 检测均线穿越（包含影线）
// 判断K线是否穿越均线：最高价在均线上方且最低价在均线下方
barCrossesMA = high >= targetEma and low <= targetEma

// 上穿：当前K线穿越均线，且前一根K线在均线下方（整体偏向上穿）
crossOver = barCrossesMA and high[1] < targetEma[1]

// 下穿：当前K线穿越均线，且前一根K线在均线上方（整体偏向下穿）
crossUnder = barCrossesMA and low[1] > targetEma[1]

// 如果只是影线触碰但前一根没穿越，则用实体方向判断
barCrossesMA2 = barCrossesMA and not crossOver and not crossUnder
crossOver := crossOver or (barCrossesMA2 and close > targetEma)
crossUnder := crossUnder or (barCrossesMA2 and close < targetEma)

// 判断是否在最近N根K线范围内
isRecentBar = bar_index >= last_bar_index - showLastBars + 1

// 显示EMA均线
plot(targetEma, color=color.new(color.blue, 0), title="目标周期EMA", linewidth=2, style=plot.style_line)

// 显示穿越标记（仅最近N根K线）
plotshape(crossOver and isRecentBar, title="上穿", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.small, text="上穿", textcolor=color.white)
plotshape(crossUnder and isRecentBar, title="下穿", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="下穿", textcolor=color.white)

// 显示当前均线值
var table maTable = table.new(position.top_left, 2, 2, bgcolor=color.new(color.black, 70), border_width=1)
table.cell(maTable, 0, 0, str.tostring(maPeriod) + "EMA " + targetTF + tfSuffix, text_color=color.white, text_size=size.small)
table.cell(maTable, 1, 0, str.tostring(targetEma, "#.##"), text_color=color.blue, text_size=size.normal)
table.cell(maTable, 0, 1, "穿越状态", text_color=color.white, text_size=size.small)
string crossStatus = crossOver ? "上穿" : crossUnder ? "下穿" : "无"
table.cell(maTable, 1, 1, crossStatus, text_color=crossOver ? color.green : crossUnder ? color.red : color.gray, text_size=size.small)