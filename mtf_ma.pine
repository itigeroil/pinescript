//@version=5
indicator("多时间框架EMA", overlay=true, shorttitle="MTF EMA")

// 参数设置
maPeriod = input.int(20, "EMA周期", minval=1)
sourcePrice = input(close, "计算源")

// 目标时间框架设置
targetTF = input.string("5", "目标时间周期", options=["1", "3", "5", "10", "15", "30", "45", "60", "120", "240", "D", "W"])
tfSuffix = input.string("分钟", "时间周期后缀", tooltip="显示在标签上的后缀")

// 获取目标时间框架的EMA数据
targetEma = request.security(syminfo.tickerid, targetTF, ta.ema(sourcePrice, maPeriod))

// 显示EMA均线
plot(targetEma, color=color.new(color.blue, 0), title="目标周期EMA", linewidth=2, style=plot.style_line)

// 显示当前均线值
var table maTable = table.new(position.top_left, 2, 1, bgcolor=color.new(color.black, 70), border_width=1)
table.cell(maTable, 0, 0, str.tostring(maPeriod) + "EMA " + targetTF + tfSuffix, text_color=color.white, text_size=size.small)
table.cell(maTable, 1, 0, str.tostring(targetEma, "#.##"), text_color=color.blue, text_size=size.normal)