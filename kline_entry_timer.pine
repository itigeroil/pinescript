//@version=5
indicator("K线入场时间提示", overlay=true, max_labels_count=500)

// 参数设置
entryBeforeSeconds = input.int(10, "K线结束前秒数", minval=1, maxval=60)
entryAfterMinutes = input.int(4, "K线开始后分钟数", minval=1, maxval=30)
showCountdown = input.bool(true, "显示倒计时")
showLabels = input.bool(true, "显示入场提示")

// 获取时间信息
barStartTime = time
barEndTime = time_close
currentTime = timenow

// 计算K线时长（毫秒）
barDuration = barEndTime - barStartTime

// 计算剩余时间（毫秒）
timeRemaining = barEndTime - currentTime

// 计算已过时间（毫秒）
timeElapsed = currentTime - barStartTime

// 转换为秒和分钟
remainingSeconds = timeRemaining / 1000
elapsedMinutes = timeElapsed / (1000 * 60)
elapsedSeconds = timeElapsed / 1000

// 计算200均线
sma200 = ta.sma(close, 200)

// 获取上根K线数据
prevClose = close[1]
prevOpen = open[1]
prevHigh = high[1]
prevLow = low[1]

// 当前K线数据
currentClose = close
currentOpen = open
currentHigh = high
currentLow = low

// 判断做多形态：阳包阴（当前阳线实体覆盖前一根阴线实体）
bullishEngulfing = currentClose > currentOpen and prevClose < prevOpen and // 当前阳线，前一根阴线
                   currentClose > prevOpen and currentOpen < prevClose and   // 实体覆盖
                   (currentClose - currentOpen) > (prevOpen - prevClose)     // 阳线实体大于阴线实体

// 判断做空形态：阴包阳（当前阴线实体覆盖前一根阳线实体）
bearishEngulfing = currentClose < currentOpen and prevClose > prevOpen and // 当前阴线，前一根阳线
                   currentClose < prevOpen and currentOpen > prevClose and   // 实体覆盖
                   (currentOpen - currentClose) > (prevClose - prevOpen)     // 阴线实体大于阳线实体

// 判断当前K线是否在200均线上方
aboveSMA200 = currentClose > sma200 and currentOpen > sma200
belowSMA200 = currentClose < sma200 and currentOpen < sma200

// 形态入场条件
bullishPatternEntry = aboveSMA200 and bullishEngulfing
bearishPatternEntry = belowSMA200 and bearishEngulfing
isPatternEntry = bullishPatternEntry or bearishPatternEntry

// 判断是否在入场时间窗口
// 条件1: K线结束前N秒
isBeforeEntry = remainingSeconds <= entryBeforeSeconds and remainingSeconds > 0
// 条件2: K线开始后N分钟内
isAfterEntry = elapsedMinutes <= entryAfterMinutes and elapsedMinutes >= 0

// 入场时间判断
isEntryTime = isBeforeEntry or isAfterEntry

// 形态+时间综合判断：必须同时满足时间窗口和形态确认
isValidEntry = isEntryTime and isPatternEntry

// 格式化倒计时显示
formatCountdown(seconds) =>
    mins = int(seconds / 60)
    secs = int(seconds % 60)
    str.tostring(mins, "00") + ":" + str.tostring(secs, "00")

// 显示倒计时表格
var table countdownTable = table.new(position.top_right, 2, 1, bgcolor=color.new(color.black, 80), border_width=1)

if showCountdown and barstate.islast
    table.cell(countdownTable, 0, 0, "K线倒计时", text_color=color.white, text_size=size.small)
    table.cell(countdownTable, 1, 0, formatCountdown(remainingSeconds), text_color=remainingSeconds < 30 ? color.red : color.green, text_size=size.normal)

// 存储标签引用以便删除
var label entryLabel = na

// 计算K线中间位置
barMiddle = (high + low) / 2

// 显示入场标签
if showLabels and barstate.islast
    // 删除之前的标签
    label.delete(entryLabel)
    
    if isValidEntry
        // 形态+时间双重确认才显示入场
        labelText := "✅" + formatCountdown(remainingSeconds)
        entryLabel := label.new(bar_index + 1, barMiddle, labelText, 
                  color=color.new(color.green, 60),
                  textcolor=color.rgb(255, 255, 255, 10),
                  style=label.style_label_left,
                  size=size.normal,
                  xloc=xloc.bar_index)
    else
        // 禁止买入标签
        labelText := "⛔" + formatCountdown(remainingSeconds)
        entryLabel := label.new(bar_index + 1, barMiddle, labelText,
                  color=color.new(color.gray, 80),
                  textcolor=color.rgb(255, 255, 255, 10),
                  style=label.style_label_left,
                  size=size.normal,
                  xloc=xloc.bar_index)

// 信息面板
var table infoPanel = table.new(position.bottom_right, 2, 6, bgcolor=color.new(color.black, 70), border_width=1)

if barstate.islast
    table.cell(infoPanel, 0, 0, "状态", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 0, isValidEntry ? "✅ 可入场" : "⛔ 禁止买入", text_color=isValidEntry ? color.green : color.red, text_size=size.small)
    
    table.cell(infoPanel, 0, 1, "入场类型", text_color=color.white, text_size=size.small)
    string entryType = isPatternEntry and isEntryTime ? "形态+时间" : isPatternEntry ? "形态确认" : isEntryTime ? "时间窗口" : "无"
    table.cell(infoPanel, 1, 1, entryType, text_color=color.yellow, text_size=size.small)
    
    table.cell(infoPanel, 0, 2, "已过时间", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 2, str.tostring(elapsedMinutes, "#.##") + " 分钟", text_color=color.white, text_size=size.small)
    
    table.cell(infoPanel, 0, 3, "剩余时间", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 3, formatCountdown(remainingSeconds), text_color=color.white, text_size=size.small)
    
    table.cell(infoPanel, 0, 4, "200均线", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 4, aboveSMA200 ? "上方" : belowSMA200 ? "下方" : "附近", text_color=aboveSMA200 ? color.green : belowSMA200 ? color.red : color.yellow, text_size=size.small)
    
    table.cell(infoPanel, 0, 5, "形态信号", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 5, bullishPatternEntry ? "做多信号" : bearishPatternEntry ? "做空信号" : "无", text_color=bullishPatternEntry ? color.green : bearishPatternEntry ? color.red : color.gray, text_size=size.small)