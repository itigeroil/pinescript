//@version=5
indicator("K线入场时间提示", overlay=true, max_labels_count=500)

// 参数设置
entryBeforeSeconds = input.int(10, "K线结束前秒数", minval=1, maxval=60)
entryAfterMinutes = input.int(4, "K线开始后分钟数", minval=1, maxval=30)
showCountdown = input.bool(true, "显示倒计时")
showLabels = input.bool(true, "显示入场提示")

// 获取时间信息
barStartTime = time
barEndTime = time_close
currentTime = timenow

// 计算K线时长（毫秒）
barDuration = barEndTime - barStartTime

// 计算剩余时间（毫秒）
timeRemaining = barEndTime - currentTime

// 计算已过时间（毫秒）
timeElapsed = currentTime - barStartTime

// 转换为秒和分钟
remainingSeconds = timeRemaining / 1000
elapsedMinutes = timeElapsed / (1000 * 60)
elapsedSeconds = timeElapsed / 1000

// 判断是否在入场时间窗口
// 条件1: K线结束前N秒
isBeforeEntry = remainingSeconds <= entryBeforeSeconds and remainingSeconds > 0
// 条件2: K线开始后N分钟内
isAfterEntry = elapsedMinutes <= entryAfterMinutes and elapsedMinutes >= 0

// 入场时间判断
isEntryTime = isBeforeEntry or isAfterEntry

// 格式化倒计时显示
formatCountdown(seconds) =>
    mins = int(seconds / 60)
    secs = int(seconds % 60)
    str.tostring(mins, "00") + ":" + str.tostring(secs, "00")

// 显示倒计时表格
var table countdownTable = table.new(position.top_right, 2, 1, bgcolor=color.new(color.black, 80), border_width=1)

if showCountdown and barstate.islast
    table.cell(countdownTable, 0, 0, "K线倒计时", text_color=color.white, text_size=size.small)
    table.cell(countdownTable, 1, 0, formatCountdown(remainingSeconds), text_color=remainingSeconds < 30 ? color.red : color.green, text_size=size.normal)

// 显示入场标签
if showLabels and barstate.islast
    // 删除之前的标签
    label.delete(label.new(bar_index, na, ""))
    
    if isEntryTime
        // 入场时间标签
        labelText = "🟢 入场时间\n剩余: " + formatCountdown(remainingSeconds)
        label.new(bar_index, high, labelText, 
                  color=color.new(color.green, 20),
                  textcolor=color.white,
                  style=label.style_label_down,
                  size=size.normal)
    else
        // 禁止买入标签
        labelText = "🔴 禁止买入\n剩余: " + formatCountdown(remainingSeconds)
        label.new(bar_index, high, labelText,
                  color=color.new(color.red, 20),
                  textcolor=color.white,
                  style=label.style_label_down,
                  size=size.normal)

// 背景颜色提示
bgcolor(isEntryTime ? color.new(color.green, 90) : color.new(color.red, 95))

// 信息面板
var table infoPanel = table.new(position.bottom_right, 2, 4, bgcolor=color.new(color.black, 70), border_width=1)

if barstate.islast
    table.cell(infoPanel, 0, 0, "状态", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 0, isEntryTime ? "✅ 入场时间" : "⛔ 禁止买入", text_color=isEntryTime ? color.green : color.red, text_size=size.small)
    
    table.cell(infoPanel, 0, 1, "已过时间", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 1, str.tostring(elapsedMinutes, "#.##") + " 分钟", text_color=color.white, text_size=size.small)
    
    table.cell(infoPanel, 0, 2, "剩余时间", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 2, formatCountdown(remainingSeconds), text_color=color.white, text_size=size.small)
    
    table.cell(infoPanel, 0, 3, "入场窗口", text_color=color.white, text_size=size.small)
    table.cell(infoPanel, 1, 3, "开始后" + str.tostring(entryAfterMinutes) + "分钟 / 结束前" + str.tostring(entryBeforeSeconds) + "秒", text_color=color.yellow, text_size=size.small)